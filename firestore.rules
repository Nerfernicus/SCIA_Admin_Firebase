rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminRole() {
      return isAdmin()
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
        : '';
    }

    function isSuperAdmin() {
      return adminRole() == 'super_admin';
    }

    function isSubOrSuperAdmin() {
      return adminRole() in ['sub_admin', 'super_admin'];
    }

    function isOwner() {
      return request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    function myBarangay() {
      return isAdmin()
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('barangay', null)
        : null;
    }

    // Barangay names are spelled two ways for Gen. T. de Leon (the mobile
    // sign-up list vs. the admin dashboard). Keep in sync with GEN_T in
    // src/lib/barangay.js.
    function isGenT(b) {
      return b is string
        && b.lower() in ['general t. de leon', 'general t de leon', 'gen. t. de leon',
                         'gen t. de leon', 'gen t de leon', 'hen. t. de leon'];
    }

    function sameBarangay(a, b) {
      return a is string && b is string && a != '' && b != ''
        && (a.lower() == b.lower() || (isGenT(a) && isGenT(b)));
    }

    // Which records a barangay sub_admin may see / act on. Uses sameBarangay()
    // so "General T. de Leon" (dashboard) and "Gen. T. de Leon" (mobile app)
    // count as the same barangay. This used to compare strings exactly, which
    // is why the Gen. T. de Leon sub_admin could see SOS alerts (the dashboard
    // filters with the alias-aware helper) but was denied when dispatching.
    function canSeeBarangay(bgy) {
      return isSuperAdmin()
        || (adminRole() == 'sub_admin'
            && (bgy == null || myBarangay() == null || myBarangay() == ''
                || sameBarangay(myBarangay(), bgy)));
    }

    // SOS alerts: an alert from outside Valenzuela is routed to the senior's
    // HOME barangay (see functions/sosRouting.js) and the dashboard lists it
    // for that office, so that office must be able to dispatch it too.
    function canHandleSos(data) {
      return canSeeBarangay(data.get('barangay', null))
        || (adminRole() == 'sub_admin'
            && sameBarangay(myBarangay(), data.get('homeBarangay', null)));
    }

    // Who may work with a record that belongs to barangay `bgy`:
    //  - the master admin (super_admin) → every barangay
    //  - a sub_admin with no barangay set (oversees everything) → every barangay
    //  - a barangay sub_admin → only their own barangay
    // A record with no barangay is only for the first two.
    function canManageBarangay(bgy) {
      return isSuperAdmin()
        || (adminRole() == 'sub_admin'
            && (myBarangay() == null || myBarangay() == '' || sameBarangay(myBarangay(), bgy)));
    }

    // The barangay the senior filled in at sign-up (null if none).
    function seniorBarangay() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('barangay', null);
    }

    // ── /admins ──────────────────────────────────────────────────────────
    match /admins/{uid} {
      // An admin reads their own record; the OSCA Super Admin can list every
      // admin so they can lock / unlock Barangay accounts. Writes go through
      // the setAdminLock Cloud Function only.
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow write: if false;
    }

    // One-time password-reset codes: server only (Admin SDK bypasses rules).
    match /password_resets/{uid} {
      allow read, write: if false;
    }

    // Audit trail written by the account-control functions.
    match /admin_audit/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── /users ───────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isSubOrSuperAdmin());

      // A new account always starts unverified; only OSCA (via the
      // approveIdVerification function) can mark a senior verified.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('isVerified', false) == false;

      // Seniors may edit their own profile but never the fields that decide
      // whether they are verified or which OSCA ID they hold.
      allow update: if request.auth != null
        && ((isSuperAdmin()
              // Deactivation (status -> SUSPENDED) is only possible through the
              // deactivateInactiveUser function, which enforces the 180-day rule.
              && (request.resource.data.get('status', '') != 'SUSPENDED'
                  || resource.data.get('status', '') == 'SUSPENDED'))
            || (request.auth.uid == userId
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                     'isVerified', 'status', 'idNumber', 'hasTempId', 'role',
                     'verifiedAt', 'previousIdNumber', 'tempIdReplacedAt',
                     'safety_alert'])));

      allow delete: if isSuperAdmin();
    }

    // ── /users/{userId}/joinedEvents ────────────────────────────────────
    match /users/{userId}/joinedEvents/{eventId} {
      allow read, create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if false;
    }

    // ── /editorial_health ────────────────────────────────────────────────
    match /editorial_health/{docId} {
      allow read: if request.auth != null;

      allow create: if isSubOrSuperAdmin() &&
        (myBarangay() == null ||
         (request.resource.data.Audience == 'BARANGAY' &&
          request.resource.data.barangay == myBarangay()));

      allow update: if isSubOrSuperAdmin() &&
        canSeeBarangay(resource.data.get('barangay', null));

      allow delete: if isSubOrSuperAdmin() &&
        canSeeBarangay(resource.data.get('barangay', null));
    }

    // ── /editorial_health/{eventId}/attendees ───────────────────────────
    match /editorial_health/{eventId}/attendees/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isSubOrSuperAdmin());

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.checkedIn == false;

      allow update: if isSubOrSuperAdmin() &&
        canSeeBarangay(get(/databases/$(database)/documents/editorial_health/$(eventId)).data.get('barangay', null));

      allow delete: if isSuperAdmin();
    }

    // ── /notifications ──────────────────────────────────────────────────
    // Written by Cloud Functions (ID request updates). A senior reads their own
    // and may only flip `read`; everything else stays server-side.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ── /admin_notifications ─────────────────────────────────────────────
    // Written by Cloud Functions (e.g. a physical ID was received / claimed).
    // Only the OSCA Super Admin reads them and may flip `read`.
    match /admin_notifications/{notificationId} {
      allow read: if isSuperAdmin();
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ── /emergencies ─────────────────────────────────────────────────────
    match /emergencies/{docId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null
        && (isOwner() || isSubOrSuperAdmin());

      allow update: if isSubOrSuperAdmin() && canHandleSos(resource.data);

      allow delete: if isSuperAdmin();
    }

    // ── /appointments ────────────────────────────────────────────────────
    match /appointments/{docId} {
      // Routing is automatic: a senior's appointment carries the barangay from
      // their own sign-up profile, and only that barangay's sub-admin (plus the
      // master admin) can see or handle it.
      allow create: if request.auth != null
        && (
          // a senior booking for themselves, in the barangay they signed up with
          (request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending'
            && (seniorBarangay() == null || seniorBarangay() == ''
                  ? request.resource.data.get('barangay', null) == null
                  : sameBarangay(request.resource.data.get('barangay', null), seniorBarangay())))
          // an admin booking on behalf of a senior in a barangay they manage
          || (isSubOrSuperAdmin()
              && canManageBarangay(request.resource.data.get('barangay', null)))
        );

      allow read: if request.auth != null
        && (isOwner()
            || (isSubOrSuperAdmin() && canManageBarangay(resource.data.get('barangay', null))));

      // Handling (confirm / cancel / complete) never moves an appointment to
      // another barangay or another senior.
      allow update: if isSubOrSuperAdmin()
        && canManageBarangay(resource.data.get('barangay', null))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['barangay', 'uid']);

      allow delete: if isSuperAdmin();
    }

    // ── /medications ─────────────────────────────────────────────────────
    match /medications/{docId} {
      allow read: if request.auth != null
        && (isOwner() || isSubOrSuperAdmin());

      allow create: if isSubOrSuperAdmin();
      allow update: if isSubOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /id_verifications ────────────────────────────────────────────────
    match /id_verifications/{docId} {
      // A senior can only submit for themselves, and only as "pending";
      // approving/rejecting is the admin's update below.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if request.auth != null
        && (isOwner() || isSuperAdmin());

      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /id_requests ─────────────────────────────────────────────────────
    // Physical ID requests are handled by the OSCA admin only (super_admin).
    // Barangay sub-admins cannot read or touch them. The senior who filed a
    // request can read their own, to follow its progress in the app.
    match /id_requests/{docId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null
        && (isOwner() || isSuperAdmin());

      allow update: if isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    // ── /osca_office ─────────────────────────────────────────────────────
    // settings: office hours + live status (open / break / closed). Everyone signed
    // in can read it (the app shows it when booking a pickup); only OSCA edits it.
    match /osca_office/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // ── /pickup_slots ────────────────────────────────────────────────────
    // pickup_slots/{YYYY-MM-DD} = { counts: { "08:00": 2 } }. Read-only for
    // clients; the bookIdPickup Cloud Function is the only writer, so a full
    // time slot cannot be overbooked from the app.
    match /pickup_slots/{day} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── /health_centers ──────────────────────────────────────────────────
    match /health_centers/{docId} {
      allow read: if request.auth != null;
      allow create: if isSubOrSuperAdmin();
      allow update: if isSubOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /announcements ───────────────────────────────────────────────────
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow create: if isSubOrSuperAdmin() &&
        (myBarangay() == null ||
         (request.resource.data.Audience == 'BARANGAY' &&
          request.resource.data.barangay == myBarangay()));
      allow update: if isSubOrSuperAdmin() &&
        canSeeBarangay(resource.data.get('barangay', null));
      allow delete: if isSubOrSuperAdmin() &&
        canSeeBarangay(resource.data.get('barangay', null));
    }

    // ── /user_lookup ─────────────────────────────────────────────────────
    match /user_lookup/{lookupKey} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isSuperAdmin();
    }

    // ── /released_ids ────────────────────────────────────────────────────
    // Record of physical IDs the OSCA admin handed out. OSCA admin only.
    match /released_ids/{docId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /digital_ids ─────────────────────────────────────────────────────
    match /digital_ids/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /digital_id_requests ─────────────────────────────────────────────
    // The senior's "Claim" tap in the app. A senior may only (re)raise their
    // own request (status 'requested'); the onDigitalIdRequested Cloud Function
    // checks they are verified, creates digital_ids/{uid} and writes the result
    // (status 'issued' / 'denied' + message) back here.
    match /digital_id_requests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'requested'
        && request.resource.data.keys().hasOnly(['uid', 'status', 'requestedAt']);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'requested'
        && resource.data.status in ['requested', 'denied', 'issued']
        && request.resource.data.keys().hasOnly(['uid', 'status', 'requestedAt', 'code', 'message', 'processedAt']);

      allow delete: if false;
    }

    // ── /sos_events (legacy) ─────────────────────────────────────────────
    match /sos_events/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (isOwner() || isSubOrSuperAdmin());
      allow update: if isSubOrSuperAdmin() && canHandleSos(resource.data);
      allow delete: if isSuperAdmin();
    }

    // ── /inactivity_alerts ───────────────────────────────────────────────
    // Audit trail written only by the monitorInactivity Cloud Function
    // (Admin SDK bypasses rules). Admins can read; nobody can write from a client.
    match /inactivity_alerts/{docId} {
      allow read: if isSubOrSuperAdmin()
        && canSeeBarangay(resource.data.get('barangay', null));
      allow write: if false;
    }

    // ── /ncsc_registrations ──────────────────────────────────────────────
    // One doc per user (doc id = uid). The app records that the senior opened
    // the NCSC registration form, then whether they finished or cancelled.
    // Admins verify or reject after checking.
    match /ncsc_registrations/{uid} {
      // The senior reads their own record; only the OSCA admin reads the rest.
      allow read: if request.auth != null
        && (request.auth.uid == uid || isSuperAdmin());

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'started';

      // The senior can only move between started / cancelled / completed_claimed
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && resource.data.status in ['started', 'cancelled', 'completed_claimed']
        && request.resource.data.status in ['started', 'cancelled', 'completed_claimed'];

      // Only the OSCA admin can verify or reject (barangay sub-admins cannot)
      allow update: if isSuperAdmin()
        && request.resource.data.status in ['verified', 'rejected'];

      allow delete: if isSuperAdmin();
    }

    // ── /ai_usage ────────────────────────────────────────────────────────
    match /ai_usage/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isSuperAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.spentUsd is number
        && request.resource.data.spentUsd >= 0
        && request.resource.data.spentUsd <= 0.02;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.spentUsd is number
        && request.resource.data.spentUsd >= resource.data.spentUsd
        && request.resource.data.spentUsd - resource.data.spentUsd <= 0.02;
      allow delete: if false;
    }
  }
}
