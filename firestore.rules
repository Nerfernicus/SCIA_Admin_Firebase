rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminRole() {
      return isAdmin()
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
        : '';
    }

    function isSuperAdmin() {
      return adminRole() == 'super_admin';
    }

    function isSubOrSuperAdmin() {
      return adminRole() in ['sub_admin', 'super_admin'];
    }

    function isOwner() {
      return request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    function myBarangay() {
      return isAdmin()
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('barangay', null)
        : null;
    }

    function canSeeBarangay(bgy) {
      return isSuperAdmin()
        || (adminRole() == 'sub_admin' && (myBarangay() == null || myBarangay() == bgy));
    }

    // ── /admins ──────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── /users ───────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isSubOrSuperAdmin());

      allow create: if request.auth != null
        && request.auth.uid == userId;

      allow update: if request.auth != null
        && (request.auth.uid == userId || isSuperAdmin());

      allow delete: if isSuperAdmin();
    }

    // ── /users/{userId}/joinedEvents ────────────────────────────────────
    match /users/{userId}/joinedEvents/{eventId} {
      allow read, create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if false;
    }

    // ── /editorial_health ────────────────────────────────────────────────
    match /editorial_health/{docId} {
      allow read: if request.auth != null;

      allow create: if isSubOrSuperAdmin() &&
        (myBarangay() == null ||
         (request.resource.data.Audience == 'BARANGAY' &&
          request.resource.data.barangay == myBarangay()));

      allow update: if isSubOrSuperAdmin() &&
        canSeeBarangay(resource.data.get('barangay', null));

      allow delete: if isSubOrSuperAdmin() &&
        canSeeBarangay(resource.data.get('barangay', null));
    }

    // ── /editorial_health/{eventId}/attendees ───────────────────────────
    match /editorial_health/{eventId}/attendees/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isSubOrSuperAdmin());

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.checkedIn == false;

      allow update: if isSubOrSuperAdmin() &&
        canSeeBarangay(get(/databases/$(database)/documents/editorial_health/$(eventId)).data.get('barangay', null));

      allow delete: if isSuperAdmin();
    }

    // ── /emergencies ─────────────────────────────────────────────────────
    match /emergencies/{docId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null
        && (isOwner() || isSubOrSuperAdmin());

      allow update: if isSubOrSuperAdmin() && canSeeBarangay(resource.data.get('barangay', null));

      allow delete: if isSuperAdmin();
    }

    // ── /appointments ────────────────────────────────────────────────────
    match /appointments/{docId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null
        && (isOwner() || isSubOrSuperAdmin());

      allow update: if isSubOrSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    // ── /medications ─────────────────────────────────────────────────────
    match /medications/{docId} {
      allow read: if request.auth != null
        && (isOwner() || isSubOrSuperAdmin());

      allow create: if isSubOrSuperAdmin();
      allow update: if isSubOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /id_verifications ────────────────────────────────────────────────
    match /id_verifications/{docId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null
        && (isOwner() || isSuperAdmin());

      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /id_requests ─────────────────────────────────────────────────────
    match /id_requests/{docId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null
        && (isOwner() || isSuperAdmin());

      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /health_centers ──────────────────────────────────────────────────
    match /health_centers/{docId} {
      allow read: if request.auth != null;
      allow create: if isSubOrSuperAdmin();
      allow update: if isSubOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /announcements ───────────────────────────────────────────────────
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow create: if isSubOrSuperAdmin() &&
        (myBarangay() == null ||
         (request.resource.data.Audience == 'BARANGAY' &&
          request.resource.data.barangay == myBarangay()));
      allow update: if isSubOrSuperAdmin() &&
        canSeeBarangay(resource.data.get('barangay', null));
      allow delete: if isSubOrSuperAdmin() &&
        canSeeBarangay(resource.data.get('barangay', null));
    }

    // ── /user_lookup ─────────────────────────────────────────────────────
    match /user_lookup/{lookupKey} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isSuperAdmin();
    }

    // ── /released_ids ────────────────────────────────────────────────────
    match /released_ids/{docId} {
      allow read: if request.auth != null && canSeeBarangay(resource.data.get('barangay', null));
      allow create: if isSuperAdmin();
      allow update: if isSubOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /digital_ids ─────────────────────────────────────────────────────
    match /digital_ids/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── /sos_events (legacy) ─────────────────────────────────────────────
    match /sos_events/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (isOwner() || isSubOrSuperAdmin());
      allow update: if isSubOrSuperAdmin() && canSeeBarangay(resource.data.get('barangay', null));
      allow delete: if isSuperAdmin();
    }

  }
}
